{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": [
    "node_modules",
    "examples",
    "src/__tests__",
    "src/__mocks__",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
